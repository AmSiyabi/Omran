# ============================================================
# مركز عمران للتدريب والاستشارات — environment template
# Copy to .env and fill in. Never commit real secrets.
# ============================================================

APP_NAME="مركز عمران"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Host-mapped port of the Docker app service (container listens on 8000)
APP_URL=http://localhost:8080

# Arabic is the source language of the application (spec §6)
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

# Storage is always UTC; the UI renders Asia/Muscat (spec §6.3)
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Muscat

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 (Docker service "db", host port 3307)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=omran
DB_USERNAME=omran
DB_PASSWORD=omran_local_secret

# Sessions (spec §9.6: 120 min sliding, secure cookies in production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Redis (Docker service "redis", host port 6380)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@omran.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Vite dev server port (5173 is used by another local project)
VITE_PORT=5174

# ------------------------------------------------------------
# Phase 1+ — auth and security
# ------------------------------------------------------------
# HaveIBeenPwned check is built into Laravel's Password rule; no key needed.

# ------------------------------------------------------------
# Phase 5+ — documents and backups
# ------------------------------------------------------------
# Private disk for receipts/contracts lives on local storage by default.
# BACKUP_ARCHIVE_PASSWORD encrypts spatie/laravel-backup archives.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# ------------------------------------------------------------
# Phase 8 — production observability
# ------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ------------------------------------------------------------
# Deferred (schema anticipates it; integration is out of v1 scope)
# ------------------------------------------------------------
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_ENV=uat
